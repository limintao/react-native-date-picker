{
  "name": "react-native-dates-picker",
  "version": "0.2.4",
  "description": "Customizable date picker for React Native",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "prepack": "bob build",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "example": "cd example && yarn start",
    "bootstrap": "yarn example && yarn install",
    "prettier": "prettier --write ."
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "react-native-date-picker",
    "react-native-datetime",
    "react-native-datetime-picker",
    "react-native-datepicker",
    "react-native-date-picker",
    "react-native-timepicker",
    "react-native-time-picker",
    "react-native-calendar",
    "react-native-daterange",
    "react-native-wheel",
    "react-native-wheel-picker",
    "datetime",
    "datetime-picker",
    "datepicker",
    "date-picker",
    "timepicker",
    "time-picker",
    "calendar",
    "daterange",
    "wheel",
    "wheel-picker"
  ],
  "repository": "https://github.com/limintao/react-native-date-picker.git",
  "author": "Li Min Tao <litude7@gmail.com> (https://github.com/limintao)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/limintao/react-native-date-picker.git/issues"
  },
  "homepage": "https://github.com/limintao/react-native-date-picker.git#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.2.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/react": "^18.3.0",
    "@types/react-native": "0.70.0",
    "@types/react-test-renderer": "^18.0.5",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "pod-install": "^1.0.0",
    "prettier": "^3.8.0",
    "react": "^18.3.0",
    "react-native": "^0.76.9",
    "react-native-builder-bob": "^0.40.0",
    "react-test-renderer": "^18.2.0",
    "release-it": "^20.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": "*"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: 🔨 release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "ignoreRecommendedBump": true
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "dependencies": {
    "dayjs": "^1.11.12"
  },
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  }
}
